@{
    ViewData["Title"] = "Dashboard";
    var userName = Context.Session.GetString("UserName") ?? "Guest";
    var userRole = Context.Session.GetString("UserRole") ?? "";
    var userEmail = Context.Session.GetString("UserEmail");
}

<style>
    /* Consistent Theme with Booking Dashboard */
    body {
        background: #f5f7fa;
    }

    .home-container {
        max-width: 1400px;
        margin: 0 auto;
        padding: 1.5rem;
    }

    /* Landing Page Styles */
    .landing-section {
        min-height: 80vh;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        text-align: center;
    }

    .home-logo-section {
        margin-bottom: 2rem;
    }

    .home-logo {
        max-width: 150px;
        height: auto;
        filter: drop-shadow(0 10px 30px rgba(102, 126, 234, 0.3));
    }

    .landing-title {
        font-size: 3rem;
        font-weight: 700;
        color: #2d3748;
        margin-bottom: 1rem;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
    }

    .landing-subtitle {
        font-size: 1.25rem;
        color: #718096;
        margin-bottom: 2.5rem;
    }

    .landing-buttons {
        display: flex;
        gap: 1rem;
        justify-content: center;
        flex-wrap: wrap;
    }

    .btn-landing-primary {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        border: none;
        color: white;
        padding: 1rem 2.5rem;
        border-radius: 50px;
        font-weight: 600;
        font-size: 1.1rem;
        transition: all 0.3s ease;
        box-shadow: 0 10px 30px rgba(102, 126, 234, 0.3);
    }

    .btn-landing-primary:hover {
        transform: translateY(-3px);
        box-shadow: 0 15px 40px rgba(102, 126, 234, 0.4);
        color: white;
    }

    .btn-landing-outline {
        background: white;
        border: 2px solid #667eea;
        color: #667eea;
        padding: 1rem 2.5rem;
        border-radius: 50px;
        font-weight: 600;
        font-size: 1.1rem;
        transition: all 0.3s ease;
        box-shadow: 0 5px 20px rgba(0, 0, 0, 0.08);
    }

    .btn-landing-outline:hover {
        background: #667eea;
        color: white;
        transform: translateY(-3px);
        box-shadow: 0 10px 30px rgba(102, 126, 234, 0.3);
    }

    /* Welcome Section - Match Dashboard */
    .welcome-section {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        border-radius: 20px;
        padding: 2rem;
        color: white;
        margin-bottom: 2rem;
        box-shadow: 0 10px 30px rgba(102, 126, 234, 0.3);
    }

    .welcome-avatar {
        width: 70px;
        height: 70px;
        border-radius: 50%;
        background: rgba(255, 255, 255, 0.2);
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        box-shadow: 0 4px 12px rgba(255, 255, 255, 0.2);
    }

    .welcome-avatar i {
        font-size: 2rem;
    }

    .welcome-content h2 {
        font-size: 1.75rem;
        font-weight: 700;
        margin-bottom: 0.5rem;
    }

    .welcome-content p {
        opacity: 0.9;
        margin-bottom: 0;
    }

    .role-badge {
        background: white;
        color: #667eea;
        padding: 0.35rem 0.75rem;
        border-radius: 20px;
        font-weight: 600;
        font-size: 0.9rem;
        display: inline-block;
    }

    /* Quick Action Cards - Match Dashboard Style */
    .quick-cards-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
        gap: 1.25rem;
        margin-bottom: 2rem;
    }

    .quick-card {
        background: white;
        border-radius: 15px;
        padding: 2rem 1.5rem;
        text-align: center;
        box-shadow: 0 2px 12px rgba(0, 0, 0, 0.08);
        transition: all 0.3s ease;
        cursor: pointer;
        border: 2px solid transparent;
        text-decoration: none;
        color: inherit;
        display: block;
    }

    .quick-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 8px 25px rgba(102, 126, 234, 0.2);
        border-color: #667eea;
        text-decoration: none;
        color: inherit;
    }

    .quick-card-icon {
        width: 70px;
        height: 70px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 1.25rem auto;
        font-size: 2rem;
        transition: all 0.3s ease;
    }

    .quick-card:hover .quick-card-icon {
        transform: scale(1.1);
    }

    .icon-primary {
        background: rgba(102, 126, 234, 0.1);
        color: #667eea;
    }

    .icon-success {
        background: rgba(25, 135, 84, 0.1);
        color: #198754;
    }

    .icon-warning {
        background: rgba(255, 193, 7, 0.1);
        color: #ffc107;
    }

    .icon-info {
        background: rgba(23, 162, 184, 0.1);
        color: #17a2b8;
    }

    .quick-card-title {
        font-size: 1.25rem;
        font-weight: 700;
        color: #2d3748;
        margin-bottom: 0.5rem;
    }

    .quick-card-description {
        font-size: 0.9rem;
        color: #718096;
        margin-bottom: 0;
    }

    /* Action Buttons Section */
    .action-section {
        background: white;
        border-radius: 15px;
        padding: 2rem;
        box-shadow: 0 2px 15px rgba(0, 0, 0, 0.08);
        margin-bottom: 2rem;
    }

    .section-title {
        font-size: 1.5rem;
        font-weight: 700;
        color: #2d3748;
        margin-bottom: 1.5rem;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .action-buttons {
        display: flex;
        gap: 1rem;
        flex-wrap: wrap;
    }

    .btn-action {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        border: none;
        color: white;
        padding: 0.75rem 2rem;
        border-radius: 50px;
        font-weight: 600;
        transition: all 0.3s ease;
        box-shadow: 0 4px 15px rgba(102, 126, 234, 0.3);
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
    }

    .btn-action:hover {
        transform: translateY(-3px);
        box-shadow: 0 6px 20px rgba(102, 126, 234, 0.4);
        color: white;
        text-decoration: none;
    }

    .btn-action-outline {
        background: white;
        border: 2px solid #667eea;
        color: #667eea;
        padding: 0.75rem 2rem;
        border-radius: 50px;
        font-weight: 600;
        transition: all 0.3s ease;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
    }

    .btn-action-outline:hover {
        background: #667eea;
        color: white;
        transform: translateY(-3px);
        text-decoration: none;
    }

    /* Features Grid */
    .features-section {
        margin-top: 3rem;
    }

    .feature-card {
        background: white;
        border-radius: 15px;
        padding: 2rem;
        box-shadow: 0 2px 12px rgba(0, 0, 0, 0.08);
        height: 100%;
        transition: all 0.3s ease;
    }

    .feature-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 8px 25px rgba(102, 126, 234, 0.15);
    }

    .feature-icon {
        width: 60px;
        height: 60px;
        border-radius: 15px;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.75rem;
        margin-bottom: 1.25rem;
    }

    .feature-title {
        font-size: 1.25rem;
        font-weight: 700;
        color: #2d3748;
        margin-bottom: 0.75rem;
    }

    .feature-description {
        font-size: 0.95rem;
        color: #718096;
        line-height: 1.6;
        margin-bottom: 0;
    }

    /* Responsive Design */
    @@media (max-width: 768px) {
        .home-container {
            padding: 1rem;
        }

        .landing-title {
            font-size: 2rem;
        }

        .landing-subtitle {
            font-size: 1rem;
        }

        .landing-buttons {
            flex-direction: column;
            width: 100%;
        }

        .btn-landing-primary,
        .btn-landing-outline {
            width: 100%;
            padding: 0.875rem 2rem;
        }

        .welcome-section {
            padding: 1.5rem;
        }

        .welcome-content h2 {
            font-size: 1.5rem;
        }

        .quick-cards-grid {
            grid-template-columns: 1fr;
        }

        .action-buttons {
            flex-direction: column;
        }

        .btn-action,
        .btn-action-outline {
            width: 100%;
            justify-content: center;
        }
    }

    @@media (min-width: 769px) and (max-width: 1024px) {
        .quick-cards-grid {
            grid-template-columns: repeat(2, 1fr);
        }
    }
</style>

@if (userEmail == null)
{
    <!-- Landing Page for Non-Logged In Users -->
    <div class="home-container">
        <div class="landing-section">
            <div class="home-logo-section">
                <img src="~/images/logo.png" alt="Hospital OP Booking" class="home-logo" />
            </div>
            <h1 class="landing-title">Hospital OP Booking System</h1>
            <p class="landing-subtitle">Easy, Fast & Secure Appointment Scheduling</p>
            <div class="landing-buttons">
                <a asp-controller="Account" asp-action="Login" class="btn-landing-primary">
                    <i class="bi bi-box-arrow-in-right me-2"></i>Sign In
                </a>
                <a asp-controller="Account" asp-action="RegisterPatient" class="btn-landing-outline">
                    <i class="bi bi-person-plus me-2"></i>Register as Patient
                </a>
            </div>
        </div>

        <!-- Features Section -->
        <div class="features-section">
            <div class="text-center mb-5">
                <h2 class="section-title justify-content-center">
                    <i class="bi bi-stars text-primary"></i>
                    Why Choose Us
                </h2>
            </div>
            <div class="row g-4">
                <div class="col-md-6 col-lg-3">
                    <div class="feature-card">
                        <div class="feature-icon">
                            <i class="bi bi-lightning-charge-fill"></i>
                        </div>
                        <h3 class="feature-title">Quick Booking</h3>
                        <p class="feature-description">Book your appointment in seconds with our streamlined process</p>
                    </div>
                </div>
                <div class="col-md-6 col-lg-3">
                    <div class="feature-card">
                        <div class="feature-icon">
                            <i class="bi bi-shield-check"></i>
                        </div>
                        <h3 class="feature-title">Secure & Safe</h3>
                        <p class="feature-description">Your data is protected with industry-standard security</p>
                    </div>
                </div>
                <div class="col-md-6 col-lg-3">
                    <div class="feature-card">
                        <div class="feature-icon">
                            <i class="bi bi-clock-history"></i>
                        </div>
                        <h3 class="feature-title">Real-time Updates</h3>
                        <p class="feature-description">Get instant notifications about your appointment status</p>
                    </div>
                </div>
                <div class="col-md-6 col-lg-3">
                    <div class="feature-card">
                        <div class="feature-icon">
                            <i class="bi bi-hospital"></i>
                        </div>
                        <h3 class="feature-title">Multiple Hospitals</h3>
                        <p class="feature-description">Choose from a wide network of trusted healthcare providers</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
}
else
{
    <!-- Dashboard for Logged In Users -->
    <div class="home-container">
        <!-- Welcome Section -->
        <div class="welcome-section">
            <div class="d-flex align-items-center gap-3 flex-wrap">
                <div class="welcome-avatar">
                    <i class="bi @(userRole == "Hospital" ? "bi-hospital" : "bi-person-circle")"></i>
                </div>
                <div class="welcome-content">
                    <h2><i class="bi bi-hand-wave me-2"></i>Welcome, @userName!</h2>
                    <p>
                        <i class="bi bi-shield-check me-1"></i>Logged in as 
                        <span class="role-badge">@userRole</span>
                    </p>
                </div>
            </div>
        </div>

        <!-- Quick Action Cards -->
        <div class="quick-cards-grid">
            @if (userRole == "Patient")
            {
                <a asp-controller="Booking" asp-action="Dashboard" class="quick-card">
                    <div class="quick-card-icon icon-primary">
                        <i class="bi bi-calendar-check"></i>
                    </div>
                    <h3 class="quick-card-title">My Appointments</h3>
                    <p class="quick-card-description">View & manage your OP appointments</p>
                </a>

                <a asp-controller="Booking" asp-action="Book" class="quick-card">
                    <div class="quick-card-icon icon-success">
                        <i class="bi bi-calendar-plus"></i>
                    </div>
                    <h3 class="quick-card-title">Book Appointment</h3>
                    <p class="quick-card-description">Schedule a new consultation</p>
                </a>
            }
            else if (userRole == "Hospital")
            {
                <a asp-controller="Hospital" asp-action="Dashboard" class="quick-card">
                    <div class="quick-card-icon icon-primary">
                        <i class="bi bi-speedometer2"></i>
                    </div>
                    <h3 class="quick-card-title">Dashboard</h3>
                    <p class="quick-card-description">View today's appointments & queue</p>
                </a>

                <a asp-controller="Hospital" asp-action="BookForPatient" class="quick-card">
                    <div class="quick-card-icon icon-success">
                        <i class="bi bi-person-plus"></i>
                    </div>
                    <h3 class="quick-card-title">Book for Patient</h3>
                    <p class="quick-card-description">Create appointment for walk-in patients</p>
                </a>
            }

            <a href="#" onclick="alert('Medical records feature coming soon!'); return false;" class="quick-card">
                <div class="quick-card-icon icon-warning">
                    <i class="bi bi-clipboard2-pulse"></i>
                </div>
                <h3 class="quick-card-title">Medical Records</h3>
                <p class="quick-card-description">Access your health history</p>
            </a>

            <a href="#" onclick="alert('Profile settings coming soon!'); return false;" class="quick-card">
                <div class="quick-card-icon icon-info">
                    <i class="bi bi-person-gear"></i>
                </div>
                <h3 class="quick-card-title">Profile Settings</h3>
                <p class="quick-card-description">Update your account details</p>
            </a>
        </div>

        <!-- Quick Actions Section -->
        <div class="action-section">
            <h3 class="section-title">
                <i class="bi bi-lightning-charge-fill"></i>
                Quick Actions
            </h3>
            <div class="action-buttons">
                @if (userRole == "Patient")
                {
                    <a asp-controller="Booking" asp-action="Book" class="btn-action">
                        <i class="bi bi-calendar-plus"></i>
                        Book New Appointment
                    </a>
                    <a asp-controller="Booking" asp-action="Dashboard" class="btn-action-outline">
                        <i class="bi bi-list-ul"></i>
                        View My Bookings
                    </a>
                }
                else if (userRole == "Hospital")
                {
                    <a asp-controller="Hospital" asp-action="Dashboard" class="btn-action">
                        <i class="bi bi-speedometer2"></i>
                        View Dashboard
                    </a>
                    <a asp-controller="Hospital" asp-action="BookForPatient" class="btn-action-outline">
                        <i class="bi bi-person-plus"></i>
                        Book for Patient
                    </a>
                    <a asp-controller="Schedule" asp-action="Doctor" class="btn-action-outline">
                        <i class="bi bi-calendar3"></i>
                        Manage Schedule
                    </a>
                }
            </div>
        </div>

        <!-- Information Cards -->
        <div class="row g-4">
            <div class="col-md-6 col-lg-3">
                <div class="feature-card">
                    <div class="feature-icon">
                        <i class="bi bi-clock-history"></i>
                    </div>
                    <h3 class="feature-title">Real-time Queue</h3>
                    <p class="feature-description">Track your position in the queue with live updates</p>
                </div>
            </div>
            <div class="col-md-6 col-lg-3">
                <div class="feature-card">
                    <div class="feature-icon">
                        <i class="bi bi-bell"></i>
                    </div>
                    <h3 class="feature-title">Notifications</h3>
                    <p class="feature-description">Get instant alerts about your appointments</p>
                </div>
            </div>
            <div class="col-md-6 col-lg-3">
                <div class="feature-card">
                    <div class="feature-icon">
                        <i class="bi bi-shield-check"></i>
                    </div>
                    <h3 class="feature-title">Secure Platform</h3>
                    <p class="feature-description">Your health data is safe and encrypted</p>
                </div>
            </div>
            <div class="col-md-6 col-lg-3">
                <div class="feature-card">
                    <div class="feature-icon">
                        <i class="bi bi-headset"></i>
                    </div>
                    <h3 class="feature-title">24/7 Support</h3>
                    <p class="feature-description">We're here to help whenever you need us</p>
                </div>
            </div>
        </div>
    </div>
}

