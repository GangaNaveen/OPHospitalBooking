@model HospitalOPBooking.Models.PatientDashboardViewModel
@{
    ViewData["Title"] = "Book Appointment";
}

<style>
    /* Modern Dashboard Styles */
    body {
        background: #f5f7fa;
    }

    .dashboard-container {
        max-width: 1400px;
        margin: 0 auto;
        padding: 1.5rem;
    }

    /* Welcome Section */
    .welcome-section {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        border-radius: 20px;
        padding: 2rem;
        color: white;
        margin-bottom: 2rem;
        box-shadow: 0 10px 30px rgba(102, 126, 234, 0.3);
    }

    .welcome-section h2 {
        font-size: 1.75rem;
        font-weight: 700;
        margin-bottom: 0.5rem;
    }

    .welcome-section p {
        opacity: 0.9;
        margin-bottom: 0;
    }

    /* Search and Filter Section */
    .filter-section {
        background: white;
        border-radius: 15px;
        padding: 1.5rem;
        margin-bottom: 2rem;
        box-shadow: 0 2px 15px rgba(0, 0, 0, 0.08);
    }

    .search-box {
        position: relative;
    }

    .search-box input {
        border-radius: 50px;
        padding: 0.75rem 1.25rem 0.75rem 3rem;
        border: 2px solid #e9ecef;
        transition: all 0.3s ease;
    }

    .search-box input:focus {
        border-color: #667eea;
        box-shadow: 0 0 0 0.2rem rgba(102, 126, 234, 0.15);
    }

    .search-box i {
        position: absolute;
        left: 1.25rem;
        top: 50%;
        transform: translateY(-50%);
        color: #6c757d;
        font-size: 1.1rem;
    }

    .filter-btn {
        border-radius: 50px;
        padding: 0.75rem 1.5rem;
        border: 2px solid #e9ecef;
        background: white;
        transition: all 0.3s ease;
        font-weight: 500;
    }

    .filter-btn:hover, .filter-btn.active {
        border-color: #667eea;
        background: #667eea;
        color: white;
    }

    /* Section Headers */
    .section-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 1.5rem;
    }

    .section-header h4 {
        font-size: 1.5rem;
        font-weight: 700;
        color: #2d3748;
        margin: 0;
    }

    .view-history-btn {
        background: transparent;
        border: 2px solid #667eea;
        color: #667eea;
        border-radius: 50px;
        padding: 0.5rem 1.5rem;
        font-weight: 600;
        transition: all 0.3s ease;
    }

    .view-history-btn:hover {
        background: #667eea;
        color: white;
    }

    /* Doctor Cards - Compact Modern Design */
    .doctors-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
        gap: 1.25rem;
        margin-bottom: 2rem;
    }

    .doctor-card {
        background: white;
        border-radius: 15px;
        padding: 1.25rem;
        box-shadow: 0 2px 12px rgba(0, 0, 0, 0.08);
        transition: all 0.3s ease;
        cursor: pointer;
        border: 2px solid transparent;
        position: relative;
        overflow: hidden;
    }

    .doctor-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 8px 25px rgba(102, 126, 234, 0.2);
        border-color: #667eea;
    }

    .doctor-card.previously-visited::before {
        content: "★";
        position: absolute;
        top: 10px;
        right: 10px;
        color: #ffc107;
        font-size: 1.5rem;
    }

    .doctor-header {
        display: flex;
        align-items: center;
        gap: 1rem;
        margin-bottom: 1rem;
    }

    .doctor-avatar {
        width: 60px;
        height: 60px;
        border-radius: 50%;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-size: 1.5rem;
        font-weight: 700;
        flex-shrink: 0;
    }

    .doctor-info {
        flex-grow: 1;
    }

    .doctor-name {
        font-size: 1.1rem;
        font-weight: 700;
        color: #2d3748;
        margin-bottom: 0.25rem;
    }

    .doctor-specialty {
        font-size: 0.9rem;
        color: #718096;
    }

    .doctor-details {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
    }

    .detail-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        font-size: 0.9rem;
    }

    .detail-label {
        color: #718096;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .detail-value {
        font-weight: 600;
        color: #2d3748;
    }

    .fee-badge {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        padding: 0.35rem 0.75rem;
        border-radius: 20px;
        font-weight: 600;
        font-size: 0.85rem;
    }

    .availability-badge {
        background: #d4edda;
        color: #155724;
        padding: 0.35rem 0.75rem;
        border-radius: 20px;
        font-weight: 600;
        font-size: 0.85rem;
    }

    .availability-badge.full {
        background: #f8d7da;
        color: #721c24;
    }

    .hospital-name {
        font-size: 0.85rem;
        color: #667eea;
        font-weight: 600;
        margin-top: 0.75rem;
        padding-top: 0.75rem;
        border-top: 1px solid #e9ecef;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    /* Recent Bookings */
    .recent-bookings {
        background: white;
        border-radius: 15px;
        padding: 1.5rem;
        box-shadow: 0 2px 15px rgba(0, 0, 0, 0.08);
    }

    .booking-item {
        display: flex;
        align-items: center;
        gap: 1rem;
        padding: 1rem;
        border-radius: 10px;
        background: #f8f9fa;
        margin-bottom: 0.75rem;
        transition: all 0.3s ease;
    }

    .booking-item:hover {
        background: #e9ecef;
    }

    .booking-item:last-child {
        margin-bottom: 0;
    }

    .booking-token {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        width: 50px;
        height: 50px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
        font-size: 1.1rem;
        flex-shrink: 0;
    }

    .booking-token.done {
        background: linear-gradient(135deg, #28a745 0%, #20c997 100%);
    }

    .booking-info {
        flex-grow: 1;
    }

    .booking-doctor {
        font-weight: 700;
        color: #2d3748;
        margin-bottom: 0.25rem;
    }

    .booking-hospital {
        font-size: 0.85rem;
        color: #718096;
    }

    .booking-date {
        font-size: 0.85rem;
        color: #718096;
        text-align: right;
    }

    .booking-status {
        padding: 0.35rem 0.75rem;
        border-radius: 20px;
        font-size: 0.8rem;
        font-weight: 600;
        white-space: nowrap;
    }

    .status-today {
        background: #cfe2ff;
        color: #084298;
    }

    .status-done {
        background: #d1e7dd;
        color: #0f5132;
    }

    .status-upcoming {
        background: #fff3cd;
        color: #664d03;
    }

    /* History Modal/Offcanvas */
    .history-offcanvas {
        width: 500px !important;
    }

    .history-item {
        border-bottom: 1px solid #e9ecef;
        padding: 1rem 0;
    }

    .history-item:last-child {
        border-bottom: none;
    }

    .queue-alert {
        background: linear-gradient(135deg, #ff6b6b 0%, #ee5a6f 100%);
        color: white;
        padding: 0.5rem 1rem;
        border-radius: 10px;
        font-size: 0.85rem;
        font-weight: 600;
        margin-top: 0.5rem;
        animation: pulse 2s infinite;
    }

    @@keyframes pulse {
        0%, 100% { opacity: 1; }
        50% { opacity: 0.8; }
    }

    /* Empty State */
    .empty-state {
        text-align: center;
        padding: 3rem 1rem;
        color: #718096;
    }

    .empty-state i {
        font-size: 4rem;
        opacity: 0.3;
        margin-bottom: 1rem;
    }

    .empty-state h5 {
        color: #2d3748;
        margin-bottom: 0.5rem;
    }

    /* Responsive */
    @@media (max-width: 768px) {
        .dashboard-container {
            padding: 1rem;
        }

        .welcome-section {
            padding: 1.5rem;
        }

        .welcome-section h2 {
            font-size: 1.5rem;
        }

        .doctors-grid {
            grid-template-columns: 1fr;
        }

        .filter-section {
            padding: 1rem;
        }

        .filter-btn {
            font-size: 0.85rem;
            padding: 0.5rem 1rem;
        }

        .history-offcanvas {
            width: 100% !important;
        }
    }

    @@media (min-width: 769px) and (max-width: 1024px) {
        .doctors-grid {
            grid-template-columns: repeat(2, 1fr);
        }
    }
</style>

<div class="dashboard-container">
    <!-- Welcome Section -->
    <div class="welcome-section">
        <h2><i class="bi bi-hand-wave me-2"></i>Welcome, @Model.PatientName!</h2>
        <p>Find and book appointments with top doctors</p>
    </div>

    <!-- Search and Filter Section -->
    <div class="filter-section">
        <div class="row g-3">
            <div class="col-md-6">
                <div class="search-box">
                    <i class="bi bi-search"></i>
                    <input type="text" id="doctorSearch" class="form-control" placeholder="Search doctors, hospitals, specialties...">
                </div>
            </div>
            <div class="col-md-6">
                <div class="d-flex gap-2 flex-wrap">
                    <button class="filter-btn active" data-filter="all">All Doctors</button>
                    <button class="filter-btn" data-filter="available">Available Today</button>
                    <button class="filter-btn" data-filter="visited">Previously Visited</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Recent Bookings Section -->
    @if (Model.MyBookings.Any())
    {
        var recentBookings = Model.MyBookings
            .Where(b => b.BookingDate.Date >= DateTime.Today || (b.BookingDate.Date == DateTime.Today.AddDays(-1) && !b.IsDone))
            .OrderByDescending(b => b.BookingDate)
            .Take(3)
            .ToList();

        @if (recentBookings.Any())
        {
            <div class="recent-bookings mb-4">
                <div class="section-header">
                    <h4><i class="bi bi-clock-history me-2"></i>Recent Bookings</h4>
                    @if (Model.MyBookings.Count > 3)
                    {
                        <button class="view-history-btn" data-bs-toggle="offcanvas" data-bs-target="#bookingHistory">
                            <i class="bi bi-list-ul me-1"></i>View History
                        </button>
                    }
                </div>

                @foreach (var b in recentBookings)
                {
                    var isToday = b.BookingDate.Date == DateTime.Today;
                    var statusClass = b.IsDone ? "done" : isToday ? "today" : "upcoming";

                    <div class="booking-item">
                        <div class="booking-token @statusClass">
                            #@b.TokenNumber
                        </div>
                        <div class="booking-info">
                            <div class="booking-doctor">Dr. @b.DoctorName</div>
                            <div class="booking-hospital"><i class="bi bi-hospital me-1"></i>@b.HospitalName</div>
                            @if (isToday && !b.IsDone && b.DoneBeforeMe == b.TokenNumber - 1)
                            {
                                <div class="queue-alert">
                                    <i class="bi bi-exclamation-circle me-1"></i>You're Next!
                                </div>
                            }
                        </div>
                        <div class="text-end">
                            <div class="booking-date">
                                <i class="bi bi-calendar3 me-1"></i>@b.BookingDate.ToString("dd MMM")
                            </div>
                            <span class="booking-status status-@statusClass mt-2 d-inline-block">
                                @if (b.IsDone)
                                {
                                    <i class="bi bi-check-circle me-1"></i><text>Completed</text>
                                }
                                else if (isToday)
                                {
                                    <i class="bi bi-clock me-1"></i><text>Today</text>
                                }
                                else
                                {
                                    <i class="bi bi-calendar-event me-1"></i><text>Upcoming</text>
                                }
                            </span>
                        </div>
                    </div>
                }
            </div>
        }
    }

    <!-- Available Doctors Section -->
    <div class="section-header">
        <h4><i class="bi bi-hospital me-2"></i>Available Doctors</h4>
        <span class="badge bg-primary" style="font-size: 1rem; padding: 0.5rem 1rem;">@Model.Hospitals.Count</span>
    </div>

    @if (!Model.Hospitals.Any())
    {
        <div class="empty-state">
            <i class="bi bi-hospital"></i>
            <h5>No Doctors Available</h5>
            <p>Please check back later or contact support</p>
        </div>
    }
    else
    {
        <div class="doctors-grid" id="doctorsGrid">
            @foreach (var h in Model.Hospitals)
            {
                var initials = string.Join("", h.DoctorName.Split(' ').Select(n => n.FirstOrDefault()));
                var isAvailable = h.TodayBookingCount < 50; // Assuming max 50 bookings per day
                var isPreviouslyVisited = h.PreviouslyBooked;

                <div class="doctor-card @(isPreviouslyVisited ? "previously-visited" : "")" 
                     data-hospital-id="@h.Id"
                     data-doctor="@h.DoctorName.ToLower()"
                     data-hospital="@h.HospitalName.ToLower()"
                     data-available="@isAvailable.ToString().ToLower()"
                     data-visited="@isPreviouslyVisited.ToString().ToLower()">
                    
                    <div class="doctor-header">
                        <div class="doctor-avatar">@initials</div>
                        <div class="doctor-info">
                            <div class="doctor-name">Dr. @h.DoctorName</div>
                            <div class="doctor-specialty">General Physician</div>
                        </div>
                    </div>

                    <div class="doctor-details">
                        <div class="detail-row">
                            <span class="detail-label">
                                <i class="bi bi-currency-rupee"></i>
                                Consultation Fee
                            </span>
                            @if (h.NewPatientFee > 0)
                            {
                                <span class="fee-badge">₹@h.NewPatientFee.ToString("N0")</span>
                            }
                            else
                            {
                                <span class="fee-badge" style="background: #6c757d;">Fee Not Configured</span>
                            }
                        </div>
                        <div class="detail-row">
                            <span class="detail-label">
                                <i class="bi bi-people"></i>
                                Today's Bookings
                            </span>
                            <span class="availability-badge @(!isAvailable ? "full" : "")">
                                @h.TodayBookingCount @(isAvailable ? "booked" : "Full")
                            </span>
                        </div>
                    </div>

                    <div class="hospital-name">
                        <i class="bi bi-hospital"></i>
                        @h.HospitalName
                    </div>
                </div>
            }
        </div>
    }
</div>

<!-- Booking History Offcanvas -->
<div class="offcanvas offcanvas-end history-offcanvas" tabindex="-1" id="bookingHistory">
    <div class="offcanvas-header">
        <h5 class="offcanvas-title"><i class="bi bi-clock-history me-2"></i>Booking History</h5>
        <button type="button" class="btn-close" data-bs-dismiss="offcanvas"></button>
    </div>
    <div class="offcanvas-body">
        @if (Model.MyBookings.Any())
        {
            var allBookings = Model.MyBookings.OrderByDescending(b => b.BookingDate).ToList();
            
            @foreach (var b in allBookings)
            {
                var isToday = b.BookingDate.Date == DateTime.Today;
                var isPast = b.BookingDate.Date < DateTime.Today;

                <div class="history-item">
                    <div class="d-flex justify-content-between align-items-start mb-2">
                        <div>
                            <div class="fw-bold">Dr. @b.DoctorName</div>
                            <div class="small text-muted">@b.HospitalName</div>
                        </div>
                        <span class="badge" style="background: @(b.IsDone ? "#28a745" : isToday ? "#0d6efd" : "#6c757d")">
                            Token #@b.TokenNumber
                        </span>
                    </div>
                    <div class="small text-muted">
                        <i class="bi bi-calendar3 me-1"></i>@b.BookingDate.ToString("dd MMM yyyy")
                        @if (b.IsDone)
                        {
                            <span class="ms-2"><i class="bi bi-check-circle text-success me-1"></i>Completed</span>
                        }
                        else if (isToday)
                        {
                            <span class="ms-2"><i class="bi bi-clock text-primary me-1"></i>Today</span>
                        }
                    </div>
                    @if (isToday && !b.IsDone)
                    {
                        <div class="mt-2 small">
                            <span class="badge bg-info">@b.DoneBeforeMe patients ahead</span>
                        </div>
                    }
                </div>
            }
        }
        else
        {
            <div class="empty-state">
                <i class="bi bi-calendar-x"></i>
                <h6>No Booking History</h6>
                <p class="small">Your booking history will appear here</p>
            </div>
        }
    </div>
</div>

@section Scripts {
<script>
    $(document).ready(function() {
        // Doctor card click - Navigate to booking page
        $('.doctor-card').on('click', function() {
            const hospitalId = $(this).data('hospital-id');
            window.location.href = `/Booking/Book?hospitalId=${hospitalId}`;
        });

        // Search functionality
        $('#doctorSearch').on('input', function() {
            const searchTerm = $(this).val().toLowerCase().trim();
            filterDoctors();
        });

        // Filter buttons
        $('.filter-btn').on('click', function() {
            $('.filter-btn').removeClass('active');
            $(this).addClass('active');
            filterDoctors();
        });

        function filterDoctors() {
            const searchTerm = $('#doctorSearch').val().toLowerCase().trim();
            const activeFilter = $('.filter-btn.active').data('filter');

            $('.doctor-card').each(function() {
                const $card = $(this);
                const doctorName = $card.data('doctor');
                const hospitalName = $card.data('hospital');
                const isAvailable = $card.data('available') === 'true';
                const isVisited = $card.data('visited') === 'true';

                // Search filter
                const matchesSearch = !searchTerm || 
                    doctorName.includes(searchTerm) || 
                    hospitalName.includes(searchTerm);

                // Category filter
                let matchesFilter = true;
                if (activeFilter === 'available') {
                    matchesFilter = isAvailable;
                } else if (activeFilter === 'visited') {
                    matchesFilter = isVisited;
                }

                // Show/hide card
                if (matchesSearch && matchesFilter) {
                    $card.show();
                } else {
                    $card.hide();
                }
            });

            // Show empty state if no results
            const visibleCards = $('.doctor-card:visible').length;
            if (visibleCards === 0 && !$('.empty-state').length) {
                $('#doctorsGrid').append(`
                    <div class="empty-state col-12">
                        <i class="bi bi-search"></i>
                        <h5>No Doctors Found</h5>
                        <p>Try adjusting your search or filters</p>
                    </div>
                `);
            } else if (visibleCards > 0) {
                $('.empty-state').remove();
            }
        }
    });
</script>
}

