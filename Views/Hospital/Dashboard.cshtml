@model HospitalOPBooking.Models.HospitalDashboardViewModel
@{
    ViewData["Title"] = "Hospital Dashboard";
    
    // Calculate additional metrics
    var activeDoctors = Model.Doctors.Count(d => d.IsActive);
    var totalRevenue = Model.TodayQueue.Sum(q => q.ConsultationFee);
    var doctorGroups = Model.TodayQueue.GroupBy(q => q.DoctorName).ToList();
}

<style>
    /* Modern Hospital Dashboard Styles */
    .dashboard-container {
        max-width: 1600px;
        margin: 0 auto;
        padding: 1.5rem;
    }

    /* Welcome Banner */
    .welcome-banner {
        background: linear-gradient(135deg, var(--primary-gradient-start) 0%, var(--primary-gradient-end) 100%);
        border-radius: var(--radius-lg);
        padding: 2rem;
        color: white;
        margin-bottom: 2rem;
        box-shadow: var(--shadow-xl);
    }

    .welcome-banner h2 {
        font-size: 1.75rem;
        font-weight: 700;
        margin-bottom: 0.5rem;
    }

    /* Summary Cards */
    .summary-cards {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 1.25rem;
        margin-bottom: 2rem;
    }

    .summary-card {
        background: white;
        border-radius: var(--radius-md);
        padding: 1.5rem;
        box-shadow: var(--shadow-md);
        transition: all var(--transition-normal);
        border-left: 4px solid;
    }

    .summary-card:hover {
        transform: translateY(-5px);
        box-shadow: var(--shadow-lg);
    }

    .summary-card.card-primary { border-left-color: var(--primary-color); }
    .summary-card.card-success { border-left-color: #28a745; }
    .summary-card.card-warning { border-left-color: #ffc107; }
    .summary-card.card-info { border-left-color: #17a2b8; }

    .summary-card-icon {
        width: 50px;
        height: 50px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.5rem;
        margin-bottom: 1rem;
    }

    .card-primary .summary-card-icon {
        background: rgba(102, 126, 234, 0.1);
        color: var(--primary-color);
    }

    .card-success .summary-card-icon {
        background: rgba(40, 167, 69, 0.1);
        color: #28a745;
    }

    .card-warning .summary-card-icon {
        background: rgba(255, 193, 7, 0.1);
        color: #ffc107;
    }

    .card-info .summary-card-icon {
        background: rgba(23, 162, 184, 0.1);
        color: #17a2b8;
    }

    .summary-card-value {
        font-size: 2rem;
        font-weight: 800;
        color: var(--text-primary);
        line-height: 1;
        margin-bottom: 0.5rem;
    }

    .summary-card-label {
        font-size: 0.875rem;
        color: var(--text-secondary);
        font-weight: 600;
    }

    /* Doctor Overview Cards */
    .doctor-overview-section {
        margin-bottom: 2rem;
    }

    .section-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 1.5rem;
    }

    .section-title {
        font-size: 1.5rem;
        font-weight: 700;
        color: var(--text-primary);
    }

    .doctor-cards-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
        gap: 1.25rem;
        margin-bottom: 2rem;
    }

    .doctor-overview-card {
        background: white;
        border-radius: var(--radius-md);
        padding: 1.5rem;
        box-shadow: var(--shadow-md);
        transition: all var(--transition-normal);
        border: 2px solid transparent;
    }

    .doctor-overview-card:hover {
        transform: translateY(-3px);
        box-shadow: var(--shadow-lg);
        border-color: var(--primary-color);
    }

    .doctor-overview-card.inactive {
        opacity: 0.6;
        background: #f8f9fa;
    }

    .doctor-card-header {
        display: flex;
        align-items: center;
        gap: 1rem;
        margin-bottom: 1rem;
        padding-bottom: 1rem;
        border-bottom: 1px solid var(--border-light);
    }

    .doctor-card-avatar {
        width: 50px;
        height: 50px;
        border-radius: 50%;
        background: linear-gradient(135deg, var(--primary-gradient-start), var(--primary-gradient-end));
        color: white;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.25rem;
        font-weight: 700;
        flex-shrink: 0;
    }

    .doctor-card-info h5 {
        font-size: 1.1rem;
        font-weight: 700;
        color: var(--text-primary);
        margin-bottom: 0.25rem;
    }

    .doctor-card-spec {
        font-size: 0.85rem;
        color: var(--text-secondary);
    }

    .doctor-card-stats {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 0.75rem;
        margin-bottom: 1rem;
    }

    .doctor-stat-item {
        text-align: center;
        padding: 0.75rem;
        background: var(--bg-light);
        border-radius: var(--radius-sm);
    }

    .doctor-stat-value {
        font-size: 1.25rem;
        font-weight: 700;
        color: var(--primary-color);
    }

    .doctor-stat-label {
        font-size: 0.75rem;
        color: var(--text-secondary);
        margin-top: 0.25rem;
    }

    .doctor-card-actions {
        display: flex;
        gap: 0.5rem;
        flex-wrap: wrap;
    }

    .doctor-card-actions .btn {
        flex: 1;
        min-width: 100px;
        font-size: 0.85rem;
        padding: 0.5rem 0.75rem;
    }

    /* Doctor-wise OP Tables */
    .doctor-queue-section {
        margin-bottom: 2rem;
    }

    .doctor-queue-accordion .accordion-item {
        border: none;
        margin-bottom: 1rem;
        border-radius: var(--radius-md);
        overflow: hidden;
        box-shadow: var(--shadow-md);
    }

    .doctor-queue-accordion .accordion-button {
        background: linear-gradient(135deg, var(--primary-gradient-start), var(--primary-gradient-end));
        color: white;
        font-weight: 600;
        padding: 1.25rem 1.5rem;
    }

    .doctor-queue-accordion .accordion-button:not(.collapsed) {
        background: linear-gradient(135deg, var(--primary-gradient-start), var(--primary-gradient-end));
        color: white;
    }

    .doctor-queue-accordion .accordion-button::after {
        filter: brightness(0) invert(1);
    }

    .doctor-queue-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        width: 100%;
    }

    .doctor-queue-stats {
        display: flex;
        gap: 2rem;
        font-size: 0.9rem;
    }

    .doctor-queue-stat {
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    /* Modern Table Styles */
    .modern-table {
        width: 100%;
        background: white;
    }

    .modern-table thead {
        background: var(--bg-light);
    }

    .modern-table th {
        padding: 1rem;
        font-weight: 600;
        font-size: 0.875rem;
        color: var(--text-secondary);
        text-transform: uppercase;
        letter-spacing: 0.5px;
        border-bottom: 2px solid var(--border-light);
    }

    .modern-table td {
        padding: 1rem;
        border-bottom: 1px solid var(--border-light);
        vertical-align: middle;
    }

    .modern-table tbody tr:hover {
        background: rgba(102, 126, 234, 0.05);
    }

    .modern-table tbody tr.row-done {
        opacity: 0.6;
        background: #f8f9fa;
    }

    .token-badge {
        display: inline-block;
        padding: 0.35rem 0.75rem;
        border-radius: var(--radius-lg);
        font-weight: 700;
        font-size: 0.875rem;
    }

    .token-badge.active {
        background: rgba(102, 126, 234, 0.1);
        color: var(--primary-color);
    }

    .token-badge.done {
        background: rgba(40, 167, 69, 0.1);
        color: #28a745;
    }

    .fee-amount {
        font-weight: 600;
        color: var(--primary-color);
    }

    /* Responsive */
    @@media (max-width: 768px) {
        .dashboard-container {
            padding: 1rem;
        }

        .summary-cards {
            grid-template-columns: repeat(2, 1fr);
        }

        .doctor-cards-grid {
            grid-template-columns: 1fr;
        }

        .doctor-queue-stats {
            flex-direction: column;
            gap: 0.5rem;
        }
    }
</style>

<div class="dashboard-container">
    <!-- Welcome Banner -->
    <div class="welcome-banner">
        <div class="d-flex align-items-center justify-content-between flex-wrap gap-3">
            <div>
                <h2><i class="bi bi-hospital-fill me-2"></i>@Model.HospitalName</h2>
                <p class="mb-0" style="opacity: 0.9;">
                    <i class="bi bi-calendar3 me-1"></i>@DateTime.Today.ToString("dddd, dd MMMM yyyy")
                </p>
            </div>
            <a asp-controller="Hospital" asp-action="BookForPatient"
               class="btn btn-light btn-lg fw-semibold">
                <i class="bi bi-calendar-plus me-2"></i>Book for Patient
            </a>
        </div>
    </div>

    <!-- Success/Error Messages -->
    @if (TempData["BookSuccess"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i><strong>Success!</strong> @TempData["BookSuccess"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["DoctorSuccess"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i><strong>Success!</strong> @TempData["DoctorSuccess"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["DoctorError"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i><strong>Error!</strong> @TempData["DoctorError"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Summary Cards -->
    <div class="summary-cards">
        <div class="summary-card card-primary">
            <div class="summary-card-icon">
                <i class="bi bi-person-badge"></i>
            </div>
            <div class="summary-card-value">@Model.Doctors.Count</div>
            <div class="summary-card-label">Total Doctors</div>
        </div>

        <div class="summary-card card-success">
            <div class="summary-card-icon">
                <i class="bi bi-check-circle-fill"></i>
            </div>
            <div class="summary-card-value">@activeDoctors</div>
            <div class="summary-card-label">Active Doctors</div>
        </div>

        <div class="summary-card card-warning">
            <div class="summary-card-icon">
                <i class="bi bi-people-fill"></i>
            </div>
            <div class="summary-card-value">@Model.TodayTotal</div>
            <div class="summary-card-label">Today's Appointments</div>
        </div>

        <div class="summary-card card-info">
            <div class="summary-card-icon">
                <i class="bi bi-currency-rupee"></i>
            </div>
            <div class="summary-card-value">₹@totalRevenue.ToString("N0")</div>
            <div class="summary-card-label">Today's Revenue</div>
        </div>

        <div class="summary-card card-success">
            <div class="summary-card-icon">
                <i class="bi bi-check2-circle"></i>
            </div>
            <div class="summary-card-value">@Model.TodayDone</div>
            <div class="summary-card-label">Completed</div>
        </div>

        <div class="summary-card card-warning">
            <div class="summary-card-icon">
                <i class="bi bi-clock-history"></i>
            </div>
            <div class="summary-card-value">@Model.TodayPending</div>
            <div class="summary-card-label">Pending</div>
        </div>
    </div>

    <!-- Doctor Overview Cards -->
    <div class="doctor-overview-section">
        <div class="section-header">
            <h4 class="section-title">
                <i class="bi bi-person-badge me-2"></i>Doctor Overview
            </h4>
            <button class="btn btn-outline-primary" data-bs-toggle="modal" data-bs-target="#manageDoctorsModal">
                <i class="bi bi-gear me-1"></i>Manage Doctors
            </button>
        </div>

        @if (!Model.Doctors.Any())
        {
            <div class="text-center py-5">
                <i class="bi bi-person-x" style="font-size: 3rem; opacity: 0.3;"></i>
                <p class="text-muted mt-3">No doctors added yet. Click "Manage Doctors" to add doctors.</p>
            </div>
        }
        else
        {
            <div class="doctor-cards-grid">
                @foreach (var doctor in Model.Doctors)
                {
                    var doctorQueue = Model.TodayQueue.Where(q => q.DoctorName == doctor.Name).ToList();
                    var doctorRevenue = doctorQueue.Sum(q => q.ConsultationFee);
                    var initials = string.Join("", doctor.Name.Split(' ').Select(n => n.FirstOrDefault()));

                    <div class="doctor-overview-card @(!doctor.IsActive ? "inactive" : "")">
                        <div class="doctor-card-header">
                            <div class="doctor-card-avatar">@initials</div>
                            <div class="doctor-card-info">
                                <h5>Dr. @doctor.Name</h5>
                                @if (!string.IsNullOrEmpty(doctor.Specialization))
                                {
                                    <div class="doctor-card-spec">@doctor.Specialization</div>
                                }
                                @if (!doctor.IsActive)
                                {
                                    <span class="badge bg-secondary mt-1">Inactive</span>
                                }
                            </div>
                        </div>

                        <div class="doctor-card-stats">
                            <div class="doctor-stat-item">
                                <div class="doctor-stat-value">@doctorQueue.Count</div>
                                <div class="doctor-stat-label">Today's OPs</div>
                            </div>
                            <div class="doctor-stat-item">
                                <div class="doctor-stat-value">₹@doctorRevenue.ToString("N0")</div>
                                <div class="doctor-stat-label">Revenue</div>
                            </div>
                        </div>

                        <div class="mb-2 small">
                            <i class="bi bi-currency-rupee text-primary me-1"></i>
                            <strong>Fee:</strong> ₹@doctor.NewPatientFee.ToString("N0")
                        </div>

                        <div class="doctor-card-actions">
                            <a asp-controller="Schedule" asp-action="Doctor" asp-route-doctorId="@doctor.Id"
                               class="btn btn-sm btn-outline-primary">
                                <i class="bi bi-calendar-week me-1"></i>Schedule
                            </a>
                            <button type="button" class="btn btn-sm btn-outline-success"
                                    onclick="openFeeRules(@doctor.Id, '@doctor.Name.Replace("'", "\\'")', @doctor.NewPatientFee)">
                                <i class="bi bi-currency-rupee me-1"></i>Fees
                            </button>
                        </div>
                    </div>
                }
            </div>
        }
    </div>

    <!-- Doctor-wise Today's OP Tables -->
    @if (doctorGroups.Any())
    {
        <div class="doctor-queue-section">
            <div class="section-header">
                <h4 class="section-title">
                    <i class="bi bi-list-columns me-2"></i>Doctor-wise Today's Queue
                </h4>
            </div>

            <div class="accordion doctor-queue-accordion" id="doctorQueueAccordion">
                @for (int i = 0; i < doctorGroups.Count; i++)
                {
                    var group = doctorGroups[i];
                    var groupRevenue = group.Sum(q => q.ConsultationFee);
                    var groupDone = group.Count(q => q.IsDone);

                    <div class="accordion-item">
                        <h2 class="accordion-header" id="heading@(i)">
                            <button class="accordion-button @(i > 0 ? "collapsed" : "")" type="button"
                                    data-bs-toggle="collapse" data-bs-target="#collapse@(i)"
                                    aria-expanded="@(i == 0 ? "true" : "false")" aria-controls="collapse@(i)">
                                <div class="doctor-queue-header">
                                    <div>
                                        <i class="bi bi-person-badge me-2"></i>
                                        <strong>Dr. @group.Key</strong>
                                    </div>
                                    <div class="doctor-queue-stats">
                                        <div class="doctor-queue-stat">
                                            <i class="bi bi-people-fill"></i>
                                            <span>@group.Count() OPs</span>
                                        </div>
                                        <div class="doctor-queue-stat">
                                            <i class="bi bi-check-circle-fill"></i>
                                            <span>@groupDone Done</span>
                                        </div>
                                        <div class="doctor-queue-stat">
                                            <i class="bi bi-currency-rupee"></i>
                                            <span>₹@groupRevenue.ToString("N0")</span>
                                        </div>
                                    </div>
                                </div>
                            </button>
                        </h2>
                        <div id="collapse@(i)" class="accordion-collapse collapse @(i == 0 ? "show" : "")"
                             aria-labelledby="heading@(i)" data-bs-parent="#doctorQueueAccordion">
                            <div class="accordion-body p-0">
                                <div class="table-responsive">
                                    <table class="modern-table">
                                        <thead>
                                            <tr>
                                                <th>Token</th>
                                                <th>Patient</th>
                                                <th>Mobile</th>
                                                <th>Fee</th>
                                                <th>Source</th>
                                                <th>Status</th>
                                                <th>Action</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var q in group.OrderBy(x => x.TokenNumber))
                                            {
                                                <tr id="row-@q.BookingId" class="@(q.IsDone ? "row-done" : "")">
                                                    <td>
                                                        <span class="token-badge @(q.IsDone ? "done" : "active")">
                                                            #@q.TokenNumber
                                                        </span>
                                                    </td>
                                                    <td class="fw-semibold">@q.PatientName</td>
                                                    <td class="text-muted small">@q.PatientMobile</td>
                                                    <td>
                                                        <span class="fee-amount">₹@q.ConsultationFee.ToString("N0")</span>
                                                        @if (!string.IsNullOrEmpty(q.FeeCategory))
                                                        {
                                                            <br />
                                                            <small class="text-muted">@q.FeeCategory</small>
                                                        }
                                                    </td>
                                                    <td>
                                                        @if (q.BookedByHospital)
                                                        {
                                                            <span class="badge bg-info">Hospital</span>
                                                        }
                                                        else
                                                        {
                                                            <span class="badge bg-light text-muted border">Patient</span>
                                                        }
                                                    </td>
                                                    <td id="status-@q.BookingId">
                                                        @if (q.IsDone)
                                                        {
                                                            <span class="badge bg-success">Done</span>
                                                        }
                                                        else
                                                        {
                                                            <span class="badge bg-warning text-dark">Pending</span>
                                                        }
                                                    </td>
                                                    <td>
                                                        @if (!q.IsDone)
                                                        {
                                                            <form class="mark-done-form" data-id="@q.BookingId">
                                                                @Html.AntiForgeryToken()
                                                                <button type="submit" class="btn btn-success btn-sm">
                                                                    <i class="bi bi-check2 me-1"></i>Done
                                                                </button>
                                                            </form>
                                                        }
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    }

    <!-- Complete Today's OP Queue -->
    @if (Model.TodayQueue.Any())
    {
        <div class="doctor-queue-section">
            <div class="section-header">
                <h4 class="section-title">
                    <i class="bi bi-list-ul me-2"></i>Complete Today's Queue
                </h4>
                <span class="badge bg-primary" style="font-size: 1rem; padding: 0.5rem 1rem;">
                    @Model.TodayQueue.Count Appointments
                </span>
            </div>

            <div style="background: white; border-radius: var(--radius-md); box-shadow: var(--shadow-md); overflow: hidden;">
                <div class="table-responsive">
                    <table class="modern-table">
                        <thead>
                            <tr>
                                <th>Token</th>
                                <th>Patient</th>
                                <th>Mobile</th>
                                <th>Doctor</th>
                                <th>Fee</th>
                                <th>Source</th>
                                <th>Status</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody id="queueBody">
                            @foreach (var q in Model.TodayQueue)
                            {
                                <tr id="row-@q.BookingId" class="@(q.IsDone ? "row-done" : "")">
                                    <td>
                                        <span class="token-badge @(q.IsDone ? "done" : "active")">
                                            #@q.TokenNumber
                                        </span>
                                    </td>
                                    <td class="fw-semibold">@q.PatientName</td>
                                    <td class="text-muted small">@q.PatientMobile</td>
                                    <td class="small">Dr. @q.DoctorName</td>
                                    <td>
                                        <span class="fee-amount">₹@q.ConsultationFee.ToString("N0")</span>
                                        @if (!string.IsNullOrEmpty(q.FeeCategory))
                                        {
                                            <br />
                                            <small class="text-muted">@q.FeeCategory</small>
                                        }
                                    </td>
                                    <td>
                                        @if (q.BookedByHospital)
                                        {
                                            <span class="badge bg-info">Hospital</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-light text-muted border">Patient</span>
                                        }
                                    </td>
                                    <td id="status-@q.BookingId">
                                        @if (q.IsDone)
                                        {
                                            <span class="badge bg-success">Done</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning text-dark">Pending</span>
                                        }
                                    </td>
                                    <td>
                                        @if (!q.IsDone)
                                        {
                                            <form class="mark-done-form" data-id="@q.BookingId">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-success btn-sm">
                                                    <i class="bi bi-check2 me-1"></i>Done
                                                </button>
                                            </form>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="text-center py-5">
            <i class="bi bi-calendar-x" style="font-size: 3rem; opacity: 0.3;"></i>
            <p class="text-muted mt-3">No appointments for today.</p>
        </div>
    }
</div>

<!-- Made with Bob -->


<!-- Manage Doctors Modal -->
<div class="modal fade" id="manageDoctorsModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">
                    <i class="bi bi-person-badge me-2"></i>Manage Doctors
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <!-- Add Doctor Form -->
                <div class="mb-4 p-3" style="background: var(--bg-light); border-radius: var(--radius-md);">
                    <h6 class="fw-bold mb-3"><i class="bi bi-plus-circle me-2"></i>Add New Doctor</h6>
                    <form asp-action="AddDoctor" asp-controller="Hospital" method="post">
                        @Html.AntiForgeryToken()
                        <div class="row g-3">
                            <div class="col-md-6">
                                <input type="text" name="Name" class="form-control"
                                       placeholder="Doctor name *" required maxlength="100" />
                            </div>
                            <div class="col-md-6">
                                <input type="text" name="Specialization" class="form-control"
                                       placeholder="Specialization" maxlength="150" />
                            </div>
                            <div class="col-md-6">
                                <div class="input-group">
                                    <span class="input-group-text">₹</span>
                                    <input type="number" name="NewPatientFee" class="form-control"
                                           placeholder="New patient fee" min="0" step="0.01" value="0" />
                                </div>
                            </div>
                            <div class="col-md-6">
                                <button type="submit" class="btn btn-primary w-100">
                                    <i class="bi bi-plus-lg me-1"></i>Add Doctor
                                </button>
                            </div>
                        </div>
                    </form>
                </div>

                <!-- Doctor List -->
                <h6 class="fw-bold mb-3"><i class="bi bi-list-ul me-2"></i>All Doctors</h6>
                @if (!Model.Doctors.Any())
                {
                    <p class="text-muted text-center py-3">No doctors added yet.</p>
                }
                else
                {
                    <ul class="list-group">
                        @foreach (var d in Model.Doctors)
                        {
                            <li class="list-group-item @(!d.IsActive ? "list-group-item-secondary" : "")"
                                id="doc-@d.Id">
                                <div class="d-flex justify-content-between align-items-center">
                                    <div>
                                        <div class="fw-semibold" id="docNameText-@d.Id">
                                            <i class="bi bi-person-circle me-1 text-primary"></i>
                                            @d.Name
                                        </div>
                                        @if (!string.IsNullOrWhiteSpace(d.Specialization))
                                        {
                                            <small class="text-muted" id="docSpecText-@d.Id">@d.Specialization</small>
                                        }
                                        <br />
                                        <small>
                                            <i class="bi bi-currency-rupee text-success me-1"></i>
                                            <strong id="docNewFee-@d.Id">₹@d.NewPatientFee.ToString("0.##")</strong>
                                            <span id="docRulesSummary-@d.Id" class="text-muted"></span>
                                        </small>
                                    </div>
                                    <div class="btn-group">
                                        <button type="button" class="btn btn-sm btn-outline-success"
                                                title="Configure Fee Rules"
                                                onclick="openFeeRules(@d.Id, '@d.Name.Replace("'","\\'")', @d.NewPatientFee)">
                                            <i class="bi bi-currency-rupee"></i>
                                        </button>
                                        <a asp-controller="Schedule" asp-action="Doctor"
                                           asp-route-doctorId="@d.Id"
                                           class="btn btn-sm btn-outline-info" title="Set Schedule">
                                            <i class="bi bi-calendar-week-fill"></i>
                                        </a>
                                        <button type="button" class="btn btn-sm btn-outline-primary"
                                                title="Edit"
                                                onclick="startEdit(@d.Id, '@d.Name.Replace("'","\\'")', '@d.Specialization.Replace("'","\\'")', @d.NewPatientFee)">
                                            <i class="bi bi-pencil-fill"></i>
                                        </button>
                                        <form asp-action="ToggleDoctor" asp-controller="Hospital"
                                              method="post" class="d-inline toggle-form" data-docid="@d.Id">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="doctorId" value="@d.Id" />
                                            <button type="submit"
                                                    class="btn btn-sm @(d.IsActive ? "btn-outline-warning" : "btn-outline-success")"
                                                    title="@(d.IsActive ? "Set Inactive" : "Set Active")">
                                                <i class="bi @(d.IsActive ? "bi-toggle-on" : "bi-toggle-off")"></i>
                                            </button>
                                        </form>
                                    </div>
                                </div>
                            </li>
                        }
                    </ul>
                }
            </div>
        </div>
    </div>
</div>

<!-- Edit Doctor Modal -->
<div class="modal fade" id="editDoctorModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" style="max-width:420px">
        <div class="modal-content">
            <div class="modal-header">
                <h6 class="modal-title fw-bold">
                    <i class="bi bi-pencil-fill me-2 text-primary"></i>Edit Doctor
                </h6>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label class="form-label fw-semibold small">Doctor Name <span class="text-danger">*</span></label>
                    <input type="text" id="editDoctorName" class="form-control" maxlength="100" placeholder="Doctor name…" />
                </div>
                <div class="mb-3">
                    <label class="form-label fw-semibold small">Specialization</label>
                    <input type="text" id="editDoctorSpec" class="form-control" maxlength="150" placeholder="e.g. Cardiologist…" />
                </div>
                <div class="mb-2">
                    <label class="form-label fw-semibold small">
                        <i class="bi bi-person-plus-fill text-primary me-1"></i>New Patient Fee (₹)
                    </label>
                    <div class="input-group">
                        <span class="input-group-text">₹</span>
                        <input type="number" id="editNewFee" class="form-control" min="0" step="0.01" placeholder="0" />
                    </div>
                    <div class="form-text">Fee for first-time patients. Revisit rules are configured separately via the <strong>₹</strong> button.</div>
                </div>
                <div id="editDoctorError" class="text-danger small mt-1 d-none"></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary btn-sm" onclick="saveEdit()">
                    <i class="bi bi-check-lg me-1"></i>Save
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Fee Rules Modal -->
<div class="modal fade" id="feeRulesModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <div>
                    <h6 class="modal-title fw-bold mb-0">
                        <i class="bi bi-currency-rupee me-2 text-success"></i>
                        Revisit Fee Rules — <span id="feeRulesDoctorName"></span>
                    </h6>
                    <div class="text-muted small mt-1">
                        Configure how much to charge based on days since the patient's last visit.
                    </div>
                </div>
                <button type="button" class="btn-close ms-3" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <!-- New Patient Fee (read-only reminder) -->
                <div class="fee-rules-base-fee mb-3">
                    <div class="d-flex align-items-center gap-3">
                        <div>
                            <div class="small text-muted fw-semibold">
                                <i class="bi bi-person-plus-fill text-primary me-1"></i>New Patient Fee
                                <span class="text-muted">(first visit / no previous visit)</span>
                            </div>
                            <div class="fw-bold text-primary fs-5">
                                ₹<span id="feeRulesNewFeeDisplay">0</span>
                            </div>
                        </div>
                        <div class="text-muted small">
                            <i class="bi bi-arrow-right me-1"></i>
                            Also applied when revisit days exceed all configured rules.
                        </div>
                    </div>
                </div>

                <!-- Rules table -->
                <div class="fw-semibold small mb-2">
                    <i class="bi bi-table me-1 text-success"></i>Revisit Rules
                    <span class="text-muted fw-normal">(applied when patient revisits within the day range)</span>
                </div>

                <div class="table-responsive">
                    <table class="table table-sm fee-rules-table mb-2" id="feeRulesTable">
                        <thead>
                            <tr>
                                <th style="width:30%">From Day <span class="text-muted fw-normal">(inclusive)</span></th>
                                <th style="width:30%">To Day <span class="text-muted fw-normal">(inclusive)</span></th>
                                <th style="width:30%">Fee (₹)</th>
                                <th style="width:10%"></th>
                            </tr>
                        </thead>
                        <tbody id="feeRulesBody">
                            <!-- rows injected by JS -->
                        </tbody>
                    </table>
                </div>

                <button type="button" class="btn btn-outline-success btn-sm" onclick="addFeeRuleRow()">
                    <i class="bi bi-plus-lg me-1"></i>Add Rule
                </button>

                <div id="feeRulesError" class="alert alert-danger py-2 small mt-3 d-none"></div>
                <div id="feeRulesSuccess" class="alert alert-success py-2 small mt-3 d-none"></div>

                <!-- Example hint -->
                <div class="fee-rules-hint mt-3">
                    <strong>Example:</strong> 0–7 days → ₹0 &nbsp;|&nbsp; 8–15 days → ₹300 &nbsp;|&nbsp; 16–30 days → ₹500
                    <br>If a patient revisits after 31 days, the <em>New Patient Fee</em> applies.
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Close</button>
                <button type="button" class="btn btn-success btn-sm" onclick="saveFeeRules()">
                    <i class="bi bi-save me-1"></i>Save Rules
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    // ── Edit Doctor ───────────────────────────────────────────────────────────
    let editingDoctorId = null;

    function startEdit(id, currentName, currentSpec, newFee) {
        editingDoctorId = id;
        document.getElementById('editDoctorName').value = currentName;
        document.getElementById('editDoctorSpec').value = currentSpec || '';
        document.getElementById('editNewFee').value     = newFee || 0;
        document.getElementById('editDoctorError').classList.add('d-none');
        new bootstrap.Modal(document.getElementById('editDoctorModal')).show();
    }

    function saveEdit() {
        const name   = document.getElementById('editDoctorName').value.trim();
        const spec   = document.getElementById('editDoctorSpec').value.trim();
        const newFee = parseFloat(document.getElementById('editNewFee').value) || 0;

        if (!name) {
            document.getElementById('editDoctorError').textContent = 'Name cannot be empty.';
            document.getElementById('editDoctorError').classList.remove('d-none');
            return;
        }

        const token = document.querySelector('input[name="__RequestVerificationToken"]');
        fetch('/Hospital/EditDoctor', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/x-www-form-urlencoded',
                'RequestVerificationToken': token?.value ?? ''
            },
            body: `doctorId=${editingDoctorId}&name=${encodeURIComponent(name)}&specialization=${encodeURIComponent(spec)}&newPatientFee=${newFee}`
        })
        .then(r => r.json())
        .then(data => {
            if (data.ok) {
                document.getElementById(`docNameText-${editingDoctorId}`).textContent = data.name;
                const specEl = document.getElementById(`docSpecText-${editingDoctorId}`);
                if (specEl) { specEl.textContent = data.spec; specEl.classList.toggle('d-none', !data.spec); }
                const feeEl = document.getElementById(`docNewFee-${editingDoctorId}`);
                if (feeEl) feeEl.textContent = '₹' + (data.newFee || 0).toFixed(2).replace(/\.00$/, '');
                bootstrap.Modal.getInstance(document.getElementById('editDoctorModal')).hide();
                location.reload(); // Reload to update doctor cards
            } else {
                document.getElementById('editDoctorError').textContent = data.msg;
                document.getElementById('editDoctorError').classList.remove('d-none');
            }
        });
    }

    // ── Fee Rules Modal ───────────────────────────────────────────────────────
    let feeRulesDoctorId  = null;
    let feeRulesNewFee    = 0;

    function openFeeRules(doctorId, doctorName, newFee) {
        feeRulesDoctorId = doctorId;
        feeRulesNewFee   = newFee;
        document.getElementById('feeRulesDoctorName').textContent    = 'Dr. ' + doctorName;
        document.getElementById('feeRulesNewFeeDisplay').textContent = (newFee || 0).toFixed(2).replace(/\.00$/, '');
        document.getElementById('feeRulesError').classList.add('d-none');
        document.getElementById('feeRulesSuccess').classList.add('d-none');

        // Load existing rules from server
        fetch(`/Hospital/GetFeeRules?doctorId=${doctorId}`)
            .then(r => r.json())
            .then(rules => {
                const tbody = document.getElementById('feeRulesBody');
                tbody.innerHTML = '';
                if (rules.length === 0) {
                    // Start with one empty row as a hint
                    addFeeRuleRow();
                } else {
                    rules.forEach(r => addFeeRuleRow(r.fromDay, r.toDay, r.fee));
                }
            });

        new bootstrap.Modal(document.getElementById('feeRulesModal')).show();
    }

    function addFeeRuleRow(fromDay = '', toDay = '', fee = '') {
        const tbody = document.getElementById('feeRulesBody');
        const tr    = document.createElement('tr');
        tr.innerHTML = `
            <td>
                <input type="number" class="form-control form-control-sm rule-from"
                       min="0" max="9999" placeholder="e.g. 0" value="${fromDay}" />
            </td>
            <td>
                <input type="number" class="form-control form-control-sm rule-to"
                       min="0" max="9999" placeholder="e.g. 7" value="${toDay}" />
            </td>
            <td>
                <div class="input-group input-group-sm">
                    <span class="input-group-text">₹</span>
                    <input type="number" class="form-control rule-fee"
                           min="0" step="0.01" placeholder="0" value="${fee}" />
                </div>
            </td>
            <td class="text-center">
                <button type="button" class="btn-icon text-danger" title="Remove row"
                        onclick="this.closest('tr').remove()">
                    <i class="bi bi-x-circle-fill"></i>
                </button>
            </td>`;
        tbody.appendChild(tr);
    }

    function saveFeeRules() {
        const errEl  = document.getElementById('feeRulesError');
        const okEl   = document.getElementById('feeRulesSuccess');
        errEl.classList.add('d-none');
        okEl.classList.add('d-none');

        // Collect rows
        const rows   = document.querySelectorAll('#feeRulesBody tr');
        const rules  = [];
        let hasError = false;

        rows.forEach((tr, idx) => {
            const from = parseInt(tr.querySelector('.rule-from').value);
            const to   = parseInt(tr.querySelector('.rule-to').value);
            const fee  = parseFloat(tr.querySelector('.rule-fee').value);

            if (isNaN(from) || isNaN(to) || isNaN(fee)) {
                errEl.textContent = `Row ${idx + 1}: All fields are required.`;
                hasError = true; return;
            }
            if (from > to) {
                errEl.textContent = `Row ${idx + 1}: "From Day" must be ≤ "To Day".`;
                hasError = true; return;
            }
            if (fee < 0) {
                errEl.textContent = `Row ${idx + 1}: Fee cannot be negative.`;
                hasError = true; return;
            }
            rules.push({ fromDay: from, toDay: to, fee });
        });

        if (hasError) { errEl.classList.remove('d-none'); return; }

        // Client-side overlap check
        for (let i = 0; i < rules.length; i++) {
            for (let j = i + 1; j < rules.length; j++) {
                if (rules[i].fromDay <= rules[j].toDay && rules[j].fromDay <= rules[i].toDay) {
                    errEl.textContent = `Rows ${i + 1} and ${j + 1} have overlapping day ranges.`;
                    errEl.classList.remove('d-none');
                    return;
                }
            }
        }

        const token = document.querySelector('input[name="__RequestVerificationToken"]').value;
        fetch(`/Hospital/SaveFeeRules?doctorId=${feeRulesDoctorId}&newPatientFee=${feeRulesNewFee}`, {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'RequestVerificationToken': token
            },
            body: JSON.stringify(rules)
        })
        .then(r => r.json())
        .then(data => {
            if (data.ok) {
                okEl.textContent = 'Fee rules saved successfully.';
                okEl.classList.remove('d-none');
                // Update the summary badge on the doctor list
                updateRulesSummary(feeRulesDoctorId, rules);
            } else {
                errEl.textContent = data.msg || 'Failed to save.';
                errEl.classList.remove('d-none');
            }
        })
        .catch(() => {
            errEl.textContent = 'Network error. Please try again.';
            errEl.classList.remove('d-none');
        });
    }

    function updateRulesSummary(doctorId, rules) {
        const el = document.getElementById(`docRulesSummary-${doctorId}`);
        if (!el) return;
        if (!rules.length) {
            el.textContent = '';
            return;
        }
        const parts = rules
            .sort((a, b) => a.fromDay - b.fromDay)
            .map(r => `${r.fromDay}–${r.toDay}d: ₹${r.fee}`);
        el.textContent = '· ' + parts.join(' | ');
    }

    // Load rule summaries on page load
    document.querySelectorAll('[id^="docRulesSummary-"]').forEach(el => {
        const docId = el.id.replace('docRulesSummary-', '');
        fetch(`/Hospital/GetFeeRules?doctorId=${docId}`)
            .then(r => r.json())
            .then(rules => updateRulesSummary(parseInt(docId), rules));
    });

    // ── Toggle Doctor (AJAX) ──────────────────────────────────────────────────
    document.querySelectorAll('.toggle-form').forEach(form => {
        form.addEventListener('submit', function (e) {
            e.preventDefault();
            const docId = this.dataset.docid;
            const token = this.querySelector('input[name="__RequestVerificationToken"]').value;
            fetch('/Hospital/ToggleDoctor', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'RequestVerificationToken': token },
                body: `doctorId=${docId}`
            })
            .then(r => r.json())
            .then(data => {
                if (!data.ok) return;
                location.reload(); // Reload to update doctor cards and stats
            });
        });
    });

    // ── Mark Done (AJAX) ──────────────────────────────────────────────────────
    document.querySelectorAll('.mark-done-form').forEach(form => {
        form.addEventListener('submit', function (e) {
            e.preventDefault();
            const id    = this.dataset.id;
            const token = this.querySelector('input[name="__RequestVerificationToken"]').value;
            fetch('/Hospital/MarkDone', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'RequestVerificationToken': token },
                body: `bookingId=${id}`
            })
            .then(r => r.json())
            .then(data => {
                if (!data.ok) return;
                // Update all instances of this row (in both doctor-wise and complete tables)
                document.querySelectorAll(`#row-${id}`).forEach(row => {
                    row.classList.add('row-done');
                    const tokenBadge = row.querySelector('.token-badge');
                    if (tokenBadge) {
                        tokenBadge.classList.remove('active');
                        tokenBadge.classList.add('done');
                    }
                });
                document.querySelectorAll(`#status-${id}`).forEach(statusEl => {
                    statusEl.innerHTML = '<span class="badge bg-success">Done</span>';
                });
                this.remove();
                
                // Update summary cards
                const completedCard = document.querySelector('.card-success:nth-of-type(2) .summary-card-value');
                const pendingCard = document.querySelector('.card-warning:nth-of-type(2) .summary-card-value');
                if (completedCard) completedCard.textContent = parseInt(completedCard.textContent) + 1;
                if (pendingCard) pendingCard.textContent = parseInt(pendingCard.textContent) - 1;
            });
        });
    });
</script>
}
