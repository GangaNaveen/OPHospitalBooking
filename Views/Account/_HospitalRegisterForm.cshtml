@model HospitalOPBooking.Models.HospitalRegisterViewModel

<form asp-action="RegisterHospital" asp-controller="Account" method="post" novalidate>
    @Html.AntiForgeryToken()

    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>

    <div class="form-floating mb-3">
        <input asp-for="HospitalName" class="form-control" placeholder="Hospital Name"
               id="hospName" autocomplete="organization" />
        <label for="hospName"><i class="bi bi-building-fill-cross me-1"></i>Hospital Name</label>
        <span asp-validation-for="HospitalName" class="text-danger small"></span>
    </div>

    <div class="form-floating mb-3">
        <input asp-for="DoctorName" class="form-control" placeholder="Doctor Name"
               id="doctorName" autocomplete="name" />
        <label for="doctorName"><i class="bi bi-person-badge me-1"></i>Doctor Name</label>
        <span asp-validation-for="DoctorName" class="text-danger small"></span>
    </div>

    <div class="row g-3 mb-3">
        <div class="col-sm-6">
            <div class="form-floating">
                <input asp-for="Email" class="form-control" placeholder="Email"
                       id="hospEmail" type="email" autocomplete="email" />
                <label for="hospEmail"><i class="bi bi-envelope me-1"></i>Email Address</label>
                <span asp-validation-for="Email" class="text-danger small"></span>
            </div>
        </div>
        <div class="col-sm-6">
            <div class="form-floating">
                <input asp-for="MobileNumber" class="form-control" placeholder="Mobile"
                       id="hospMobile" type="tel" maxlength="10" autocomplete="tel" />
                <label for="hospMobile"><i class="bi bi-phone me-1"></i>Mobile Number</label>
                <span asp-validation-for="MobileNumber" class="text-danger small"></span>
            </div>
        </div>
    </div>

    <div class="form-floating mb-3">
        <textarea asp-for="Address" class="form-control" placeholder="Address"
                  id="hospAddress" style="height:90px"></textarea>
        <label for="hospAddress"><i class="bi bi-geo-alt me-1"></i>Address</label>
        <span asp-validation-for="Address" class="text-danger small"></span>
    </div>

    <div class="form-floating mb-3 password-field">
        <input asp-for="Password" class="form-control" placeholder="Password"
               id="hospPassword" type="password" autocomplete="new-password" />
        <label for="hospPassword"><i class="bi bi-lock me-1"></i>Password</label>
        <button type="button" class="toggle-pw" onclick="togglePassword('hospPassword', this)">
            <i class="bi bi-eye"></i>
        </button>
        <span asp-validation-for="Password" class="text-danger small"></span>
    </div>

    <div class="form-floating mb-4 password-field">
        <input asp-for="ConfirmPassword" class="form-control" placeholder="Confirm Password"
               id="hospConfirm" type="password" autocomplete="new-password" />
        <label for="hospConfirm"><i class="bi bi-lock-fill me-1"></i>Confirm Password</label>
        <button type="button" class="toggle-pw" onclick="togglePassword('hospConfirm', this)">
            <i class="bi bi-eye"></i>
        </button>
        <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
    </div>

    <button type="submit" class="btn btn-primary btn-auth w-100">
        <i class="bi bi-building-check me-2"></i>Register Hospital
    </button>
</form>
